{
    "name": "clean-workspace",
    "displayName": "Clean Workspace (No More .vscode)",
    "description": "Keep your workspace 100% clean. Redirects compiled binaries & build artifacts away from project folders.",
    "version": "0.2.1",
    "publisher": "loerei",
    "main": "./extension.js",
    "activationEvents": [
        "onCommand:clean-workspace.excludeCurrentFolder",
        "onCommand:clean-workspace.includeCurrentFolder",
        "onCommand:clean-workspace.toggleMode"
    ],
    "engines": {
        "vscode": "^1.80.0"
    },
    "categories": [
        "Education",
        "Other"
    ],
    "keywords": [
        "clean workspace",
        "binary isolator",
        "clean build",
        "workspace hygiene",
        "exclude mode"
    ],
    "icon": "icon.png",
    "galleryBanner": {
        "color": "#1a1a1a",
        "theme": "dark"
    },
    "homepage": "https://github.com/loerei/no-more-dotvscode#readme",
    "repository": {
        "type": "git",
        "url": "https://github.com/loerei/no-more-dotvscode.git"
    },
    "bugs": {
        "url": "https://github.com/loerei/no-more-dotvscode/issues"
    },
    "contributes": {
        "commands": [
            {
                "command": "clean-workspace.excludeCurrentFolder",
                "title": "Clean Workspace: Exclude Current Folder"
            },
            {
                "command": "clean-workspace.includeCurrentFolder",
                "title": "Clean Workspace: Include Current Folder"
            },
            {
                "command": "clean-workspace.toggleMode",
                "title": "Clean Workspace: Toggle Mode (Exclude / Include)"
            }
        ],
        "configuration": {
            "title": "Clean Workspace",
            "properties": {
                "clean-workspace.mode": {
                    "type": "string",
                    "enum": [
                        "exclude",
                        "include"
                    ],
                    "default": "exclude",
                    "description": "Select mode: 'exclude' cleans all folders except listed ones; 'include' cleans ONLY listed folders."
                },
                "clean-workspace.excludedFolders": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [],
                    "description": "List of folder paths to exclude from auto-cleaning."
                },
                "clean-workspace.includedFolders": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [],
                    "description": "List of folder paths to include for auto-cleaning."
                },
                "clean-workspace.buildDirectory": {
                    "type": "string",
                    "default": "C:\\VscodeBuilds",
                    "description": "Global directory where all compiled executables and build artifacts are stored."
                },
                "code-runner.runInTerminal": {
                    "type": "boolean",
                    "default": true,
                    "scope": "resource"
                },
                "code-runner.saveFileBeforeRun": {
                    "type": "boolean",
                    "default": true,
                    "scope": "resource"
                },
                "code-runner.clearPreviousOutput": {
                    "type": "boolean",
                    "default": true,
                    "scope": "resource"
                },
                "code-runner.executorMap": {
                    "type": "object",
                    "default": {
                        "c": "powershell -NoProfile -ExecutionPolicy Bypass -File C:\\VscodeBuilds\\run_code.ps1 \"$filePath\" c",
                        "cpp": "powershell -NoProfile -ExecutionPolicy Bypass -File C:\\VscodeBuilds\\run_code.ps1 \"$filePath\" cpp",
                        "python": "powershell -NoProfile -ExecutionPolicy Bypass -File C:\\VscodeBuilds\\run_code.ps1 \"$filePath\" python",
                        "java": "powershell -NoProfile -ExecutionPolicy Bypass -File C:\\VscodeBuilds\\run_code.ps1 \"$filePath\" java",
                        "go": "powershell -NoProfile -ExecutionPolicy Bypass -File C:\\VscodeBuilds\\run_code.ps1 \"$filePath\" go",
                        "javascript": "powershell -NoProfile -ExecutionPolicy Bypass -File C:\\VscodeBuilds\\run_code.ps1 \"$filePath\" javascript",
                        "typescript": "powershell -NoProfile -ExecutionPolicy Bypass -File C:\\VscodeBuilds\\run_code.ps1 \"$filePath\" typescript",
                        "csharp": "powershell -NoProfile -ExecutionPolicy Bypass -File C:\\VscodeBuilds\\run_code.ps1 \"$filePath\" csharp",
                        "rust": "powershell -NoProfile -ExecutionPolicy Bypass -File C:\\VscodeBuilds\\run_code.ps1 \"$filePath\" rust",
                        "html": "powershell -NoProfile -ExecutionPolicy Bypass -File C:\\VscodeBuilds\\run_code.ps1 \"$filePath\" html",
                        "shellscript": "powershell -NoProfile -ExecutionPolicy Bypass -File C:\\VscodeBuilds\\run_code.ps1 \"$filePath\" shellscript",
                        "bat": "powershell -NoProfile -ExecutionPolicy Bypass -File C:\\VscodeBuilds\\run_code.ps1 \"$filePath\" bat",
                        "cmd": "powershell -NoProfile -ExecutionPolicy Bypass -File C:\\VscodeBuilds\\run_code.ps1 \"$filePath\" cmd",
                        "powershell": "powershell -NoProfile -ExecutionPolicy Bypass -File C:\\VscodeBuilds\\run_code.ps1 \"$filePath\" ps1",
                        "ps1": "powershell -NoProfile -ExecutionPolicy Bypass -File C:\\VscodeBuilds\\run_code.ps1 \"$filePath\" ps1",
                        "exe": "powershell -NoProfile -ExecutionPolicy Bypass -File C:\\VscodeBuilds\\run_code.ps1 \"$filePath\" exe"
                    },
                    "scope": "resource"
                }
            }
        }
    }
}
